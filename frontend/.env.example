# Leave empty to run entirely on mock data/auth (no backend needed).
# The backend is served locally by Laravel Herd, not `php artisan serve` —
# port 8000 is reserved for the ML service, so do NOT point this at :8000.
VITE_API_BASE_URL=http://cinematch.test/api

# Optional but recommended — real movie/show posters via TMDB.
# Free key: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
